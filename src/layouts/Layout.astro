---
import "@fontsource-variable/archivo";
import structiaIcon from "../assets/structia-icon.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={structiaIcon.src} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      !(function (i, n) {
        i._plt =
          i._plt || (n && n.timeOrigin ? n.timeOrigin + n.now() : Date.now());
      })(window, performance);
    </script>
    <link
      rel="preload"
      href="https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/699f264144f8b87400f661f7/v4/player.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://scripts.converteai.net/lib/js/smartplayer-wc/v4/smartplayer.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://cdn.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/699f25e8c21948fd235f9e11/main.m3u8"
      as="fetch"
    />
    <link rel="dns-prefetch" href="https://cdn.converteai.net" />
    <link rel="dns-prefetch" href="https://scripts.converteai.net" />
    <link rel="dns-prefetch" href="https://images.converteai.net" />
    <link rel="dns-prefetch" href="https://api.vturb.com.br" />
    <title>
      Structia | Domina el Flipping Inmobiliario y Escala tu Negocio
    </title>
    <slot name="head" />
  </head>
  <body>
    <div class="page-root">
      <div class="layout-container">
        <slot />
      </div>
      <footer class="site-footer">
        <p class="site-footer-text">Structia todos los derechos reservados</p>
      </footer>
    </div>

    <script>
      // Reveal on scroll: añade .is-revealed cuando el elemento entra en viewport
      function initReveal() {
        const els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
      initReveal();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: "Archivo Variable", sans-serif;
    font-size: 1.25rem;
    background: #f8f8f8;
    overflow-x: hidden;
  }

  /* Reveal on scroll: los elementos con [data-reveal] entran con fundido +
     desplazamiento al aparecer en pantalla (escalonado vía --reveal-delay). */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-reveal],
    [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .page-root {
    position: relative;
  }
  /* Fondo de luz ambiental UNIFICADO para toda la página: una capa fija
     detrás del contenido, así el degradado fluye continuo entre secciones
     (sin cortes). Las secciones van transparentes encima. */
  .page-root::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        55% 48% at 10% 6%,
        rgba(70, 66, 216, 0.22),
        transparent 66%
      ),
      radial-gradient(
        55% 48% at 90% 20%,
        rgba(162, 157, 255, 0.19),
        transparent 66%
      ),
      radial-gradient(
        58% 50% at 84% 76%,
        rgba(124, 92, 255, 0.19),
        transparent 66%
      ),
      radial-gradient(
        55% 48% at 14% 90%,
        rgba(92, 115, 240, 0.16),
        transparent 66%
      );
  }
  .layout-container {
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0;
  }
  .container > * {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .layout-container {
      max-width: 1000px;
      padding: 0 1.5rem;
    }
  }

  .site-footer {
    width: 100%;
    padding: 2rem 1rem;
    text-align: center;
    background: #f8f8f8;
    margin-top: auto;
  }

  .site-footer-text {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.5);
    font-weight: 400;
  }
</style>
