---
import "@fontsource-variable/archivo";
import BackgroundShapes from "../components/BackgroundShapes.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <div class="page-root">
      <BackgroundShapes />
      <div class="layout-container">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Archivo Variable", sans-serif;
    font-size: 1.25rem;
    background: #f8f8f8;
    overflow-x: hidden;
  }
  .page-root {
    position: relative;
  }
  .layout-container {
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0;
  }
  .container > * {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .layout-container {
      max-width: 80ch;
      padding: 0 1.5rem;
    }
  }
</style>
