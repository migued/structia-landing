---
import "@fontsource-variable/archivo";
import structiaIcon from "../assets/structia-icon.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={structiaIcon.src} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      !(function (i, n) {
        i._plt =
          i._plt || (n && n.timeOrigin ? n.timeOrigin + n.now() : Date.now());
      })(window, performance);
    </script>
    <link
      rel="preload"
      href="https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/699f264144f8b87400f661f7/v4/player.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://scripts.converteai.net/lib/js/smartplayer-wc/v4/smartplayer.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://cdn.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/699f25e8c21948fd235f9e11/main.m3u8"
      as="fetch"
    />
    <link rel="dns-prefetch" href="https://cdn.converteai.net" />
    <link rel="dns-prefetch" href="https://scripts.converteai.net" />
    <link rel="dns-prefetch" href="https://images.converteai.net" />
    <link rel="dns-prefetch" href="https://api.vturb.com.br" />
    <title>
      Structia | Sesión de Apertura — Tu mapa en 45 minutos
    </title>
    <slot name="head" />
  </head>
  <body>
    <div class="page-root">
      <div class="layout-container">
        <slot />
      </div>
      <footer class="site-footer">
        <p class="site-footer-text">Structia todos los derechos reservados</p>
      </footer>
    </div>

    <script>
      // Reveal on scroll: añade .is-revealed cuando el elemento entra en viewport
      function initReveal() {
        const els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
      initReveal();
    </script>
  </body>
</html>

<style is:global>
  /* ============================================================
     Sistema de diseño — claro, moderno y minimalista.
     El oscuro se reserva para acentos puntuales (bono, cierre).
     ============================================================ */
  :root {
    --ink: #12132a;
    --ink-soft: #4b5563;
    --ink-mute: #6b7280;
    --line: rgba(18, 19, 42, 0.1);
    --line-soft: rgba(18, 19, 42, 0.06);
    --bg: #f7f7fa;
    --card: #ffffff;
    /* Superficie con un degradado mínimo, para tarjetas grandes */
    --card-soft: linear-gradient(180deg, #ffffff 0%, #fbfbfe 100%);
    --brand: #4642d8;
    --brand-2: #7c5cff;
    --brand-3: #a29dff;
    --brand-soft: rgba(70, 66, 216, 0.08);
    --dark: #12132a;
    --green: #059669;
    --radius: 1.25rem;
    --shadow-sm:
      0 1px 2px rgba(18, 19, 42, 0.04), 0 8px 24px rgba(18, 19, 42, 0.05);
    --shadow-md:
      0 2px 6px rgba(18, 19, 42, 0.05), 0 18px 44px rgba(18, 19, 42, 0.08);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: "Archivo Variable", sans-serif;
    font-size: 1.125rem;
    color: var(--ink);
    /* Base con un degradado vertical apenas perceptible para que el
       fondo no se lea plano de arriba a abajo. */
    background:
      linear-gradient(
        180deg,
        #fbfbfe 0%,
        #f6f6fb 32%,
        #f2f2f9 68%,
        #f7f7fb 100%
      )
      no-repeat;
    background-color: var(--bg);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Reveal on scroll: los elementos con [data-reveal] entran con fundido +
     desplazamiento al aparecer en pantalla (escalonado vía --reveal-delay). */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-reveal],
    [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .page-root {
    position: relative;
  }
  /* Dos capas de luz ambiental:
     ::before va fija al viewport (halo constante, muy tenue)
     ::after recorre todo el documento, así el tinte cambia al hacer
     scroll y ninguna sección queda sobre un fondo plano. */
  .page-root::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        60% 45% at 6% 2%,
        rgba(70, 66, 216, 0.07),
        transparent 68%
      ),
      radial-gradient(
        55% 45% at 96% 16%,
        rgba(162, 157, 255, 0.07),
        transparent 68%
      ),
      radial-gradient(
        60% 50% at 90% 88%,
        rgba(124, 92, 255, 0.06),
        transparent 70%
      );
  }
  .page-root::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        46% 7% at 80% 10%,
        rgba(124, 92, 255, 0.11),
        transparent 70%
      ),
      radial-gradient(
        52% 8% at 10% 27%,
        rgba(70, 66, 216, 0.1),
        transparent 70%
      ),
      radial-gradient(
        48% 7% at 90% 45%,
        rgba(162, 157, 255, 0.12),
        transparent 70%
      ),
      radial-gradient(
        54% 8% at 8% 63%,
        rgba(92, 115, 240, 0.09),
        transparent 70%
      ),
      radial-gradient(
        46% 7% at 84% 80%,
        rgba(124, 92, 255, 0.1),
        transparent 70%
      ),
      radial-gradient(
        50% 7% at 14% 94%,
        rgba(70, 66, 216, 0.08),
        transparent 70%
      );
  }
  .layout-container {
    margin: 0 auto;
    padding: 0 1rem;
  }

  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0;
  }
  .container > * {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .layout-container {
      max-width: 1080px;
      padding: 0 1.5rem;
    }
  }

  /* ===== Utilidades de sección ===== */
  .section {
    width: 100%;
    padding: 3.5rem 0;
  }
  .section-head {
    max-width: 48rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
    background: var(--brand-soft);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 4.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }
  .section-title em {
    font-style: italic;
    color: var(--brand);
    background: linear-gradient(90deg, var(--brand), var(--brand-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-right: 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .section-sub {
    max-width: 34rem;
    margin-inline: auto;
    margin-top: 0.9rem;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .section {
      padding: 4.5rem 0;
    }
  }

  .site-footer {
    width: 100%;
    padding: 2.5rem 1rem;
    text-align: center;
    border-top: 1px solid var(--line-soft);
    margin-top: auto;
  }

  .site-footer-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-mute);
    font-weight: 400;
  }
</style>
