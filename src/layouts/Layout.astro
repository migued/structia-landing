---
import "@fontsource-variable/archivo";
import BackgroundShapes from "../components/BackgroundShapes.astro";
import structiaIcon from "../assets/structia-icon.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={structiaIcon.src} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      !(function (i, n) {
        i._plt =
          i._plt || (n && n.timeOrigin ? n.timeOrigin + n.now() : Date.now());
      })(window, performance);
    </script>
    <link
      rel="preload"
      href="https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/699f264144f8b87400f661f7/v4/player.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://scripts.converteai.net/lib/js/smartplayer-wc/v4/smartplayer.js"
      as="script"
    />
    <link
      rel="preload"
      href="https://cdn.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/699f25e8c21948fd235f9e11/main.m3u8"
      as="fetch"
    />
    <link rel="dns-prefetch" href="https://cdn.converteai.net" />
    <link rel="dns-prefetch" href="https://scripts.converteai.net" />
    <link rel="dns-prefetch" href="https://images.converteai.net" />
    <link rel="dns-prefetch" href="https://api.vturb.com.br" />
    <title>
      Structia | Domina el Flipping Inmobiliario y Escala tu Negocio
    </title>
  </head>
  <body>
    <div class="page-root">
      <BackgroundShapes />
      <div class="layout-container">
        <slot />
      </div>
      <footer class="site-footer">
        <p class="site-footer-text">Structia todos los derechos reservados</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Archivo Variable", sans-serif;
    font-size: 1.25rem;
    background: #f8f8f8;
    overflow-x: hidden;
  }
  .page-root {
    position: relative;
  }
  .layout-container {
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0;
  }
  .container > * {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .layout-container {
      max-width: 1000px;
      padding: 0 1.5rem;
    }
  }

  .site-footer {
    width: 100%;
    padding: 2rem 1rem;
    text-align: center;
    background: #f8f8f8;
    margin-top: auto;
  }

  .site-footer-text {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.5);
    font-weight: 400;
  }
</style>
