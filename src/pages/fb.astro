---
import Layout from "../layouts/Layout.astro";
import HeroVsl from "../components/HeroVsl.astro";
import HeroContent from "../components/HeroContent.astro";
import ForYouSection from "../components/ForYouSection.astro";
import ConsultantsSection from "../components/ConsultantsSection.astro";
import PillarsBanner from "../components/PillarsBanner.astro";

const fbVideo = `<vturb-smartplayer id="vid-69e8e5d53a084e4af12b6da9" style="display: block; margin: 0 auto; width: 100%; "></vturb-smartplayer> <script type="text/javascript"> var s=document.createElement("script"); s.src="https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/69e8e5d53a084e4af12b6da9/v4/player.js", s.async=!0,document.head.appendChild(s); <\/script>`;
---

<Layout>
  <!-- Script de redirección A/B temporalmente oculto
  <script slot="head" is:inline>
    (function () {
      var shouldRedirectToVariant = Math.random() < 0.5;
      if (!shouldRedirectToVariant) return;

      var targetPath = "/fb-b" + window.location.search + window.location.hash;
      window.location.replace(targetPath);
    })();
  </script>
  -->

  <script slot="head" is:inline>
    window.pixelId = "69cc7f542240ec0e4d934501";
    var a = document.createElement("script");
    a.setAttribute("async", "");
    a.setAttribute("defer", "");
    a.setAttribute("src", "https://cdn.utmify.com.br/scripts/pixel/pixel.js");
    document.head.appendChild(a);
  </script>

  <HeroVsl videoEmbed={fbVideo} />

  <div id="delayed-content" class="hide">
    <HeroContent />
    <ForYouSection />
    <PillarsBanner />
    <ConsultantsSection />
  </div>

  <style>
    /* Ocultar permanentemente las secciones solicitadas */
    .hide {
      display: none !important;
    }
    :global(.site-footer) {
      display: none !important;
    }
    :global(body:not(.show-footer) .layout-container) {
      padding-bottom: 6rem;
    }
  </style>

  <!-- Script de delay desactivado permanentemente
  <script is:inline>
    // Configuración de Delay (en segundos)
    const VIDEO_DELAY = 475; // 7:55 minutos
    
    document.addEventListener("player:ready", function (event) {
      const player = event.detail.player || document.querySelector("vturb-smartplayer");
      
      if (player) {
        player.displayHiddenElements(
          VIDEO_DELAY,
          [".hide", ".site-footer"],
          { persist: true }
        );
      }
    });

    // Observer para remover el padding inferior extra cuando VTurb muestre las secciones
    const content = document.querySelector(".hide");
    if (content) {
      // Verificamos si, por caché, VTurb ya lo mostró de inmediato
      if (content.style.display !== "none" && content.style.display !== "") {
        document.body.classList.add("show-footer");
      } else {
        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.target.style.display !== "none") {
              document.body.classList.add("show-footer");
              observer.disconnect();
              break;
            }
          }
        });
        observer.observe(content, {
          attributes: true,
          attributeFilter: ["style"],
        });
      }
    }
  </script>
  -->
</Layout>
