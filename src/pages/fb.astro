---
import Layout from "../layouts/Layout.astro";
import HeroVsl from "../components/HeroVsl.astro";
import HeroContent from "../components/HeroContent.astro";
import ForYouSection from "../components/ForYouSection.astro";
import ConsultantsSection from "../components/ConsultantsSection.astro";
import PillarsBanner from "../components/PillarsBanner.astro";

const fbVideo = `<vturb-smartplayer id="ab-69e8ffbf9813ca264c26ad80" style="display: block; margin: 0 auto; width: 100%; "></vturb-smartplayer> <script type="text/javascript"> var s=document.createElement("script"); s.src="https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/ab-test/69e8ffbf9813ca264c26ad80/player.js", s.async=!0,document.head.appendChild(s); </script>`;
---

<Layout>
  <!-- Script de redirección A/B temporalmente oculto
  <script slot="head" is:inline>
    (function () {
      var shouldRedirectToVariant = Math.random() < 0.5;
      if (!shouldRedirectToVariant) return;

      var targetPath = "/fb-b" + window.location.search + window.location.hash;
      window.location.replace(targetPath);
    })();
  </script>
  -->

  <script slot="head" is:inline>
    window.pixelId = "69cc7f542240ec0e4d934501";
    var a = document.createElement("script");
    a.setAttribute("async", "");
    a.setAttribute("defer", "");
    a.setAttribute("src", "https://cdn.utmify.com.br/scripts/pixel/pixel.js");
    document.head.appendChild(a);
  </script>

  <HeroVsl videoEmbed={fbVideo} />

  <div id="delayed-content">
    <HeroContent />
    <ForYouSection />
    <PillarsBanner />
    <ConsultantsSection />
  </div>

  <style>
    /* Ocultar inicialmente en esta página y mostrarlo cuando corresponda */
    :global(#delayed-content) {
      display: none;
    }
    :global(.site-footer) {
      display: none !important;
    }
    :global(body:not(.show-footer) .layout-container) {
      padding-bottom: 6rem;
    }
  </style>

  <script is:inline>
    // Configuración de Delay por ID de video (VTurb A/B Test)
    var listPitch = {
      "69e8e93805c3ed4453dc4bfd": { delay: 475 },
      "69e8e83371026a90eafe7bb1": { delay: 475 },
    };

    var alreadyInitialized = false;

    document.addEventListener("player:ready", function (event) {
      if (alreadyInitialized) return;

      var detail = event.detail || {};
      var config = detail.config || {};
      var player = detail.player || document.querySelector("vturb-smartplayer");
      var playerId = config.id;
      var pitchConfig = listPitch[playerId];

      if (!playerId || !pitchConfig) return;

      alreadyInitialized = true;

      // Sincronizar elementos ocultos con el delay del video actual
      player.displayHiddenElements(
        pitchConfig.delay,
        ["#delayed-content", ".site-footer"],
        { persist: true },
      );
    });

    // Observer para remover el padding inferior extra cuando VTurb muestre las secciones
    const content = document.getElementById("delayed-content");
    if (content) {
      // Verificamos si, por caché, VTurb ya lo mostró de inmediato
      if (content.style.display !== "none" && content.style.display !== "") {
        document.body.classList.add("show-footer");
      } else {
        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.target.style.display !== "none") {
              document.body.classList.add("show-footer");
              observer.disconnect();
              break;
            }
          }
        });
        observer.observe(content, {
          attributes: true,
          attributeFilter: ["style"],
        });
      }
    }
  </script>
</Layout>
