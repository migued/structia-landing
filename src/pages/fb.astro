---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import ForYouSection from "../components/ForYouSection.astro";
import ConsultantsSection from "../components/ConsultantsSection.astro";
import PillarsBanner from "../components/PillarsBanner.astro";

const fbVideo = `<vturb-smartplayer id="vid-69b04c61a61fe7c3c1e55564" style="display: block; margin: 0 auto; width: 100%;"></vturb-smartplayer>
<script type="text/javascript">
  var s = document.createElement("script");
  s.src = "https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/69b04c61a61fe7c3c1e55564/v4/player.js";
  s.async = true;
  document.head.appendChild(s);
</script>`;
---

<Layout>
  <HeroSection videoEmbed={fbVideo} />
  <ForYouSection />
  <PillarsBanner />
  <ConsultantsSection />
</Layout>
