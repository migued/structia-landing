---
import Layout from "../layouts/Layout.astro";
import HeroVsl from "../components/HeroVsl.astro";
import HeroContent from "../components/HeroContent.astro";
import ForYouSection from "../components/ForYouSection.astro";
import ConsultantsSection from "../components/ConsultantsSection.astro";
import PillarsBanner from "../components/PillarsBanner.astro";

const fbVideo = `<vturb-smartplayer id="vid-69b04c61a61fe7c3c1e55564" style="display: block; margin: 0 auto; width: 100%;"></vturb-smartplayer>
<script type="text/javascript">
  var s = document.createElement("script");
  s.src = "https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/69b04c61a61fe7c3c1e55564/v4/player.js";
  s.async = true;
  document.head.appendChild(s);
</script>`;
---

<Layout>
  <script slot="head" is:inline>
    window.pixelId = "69cc7f542240ec0e4d934501";
    var a = document.createElement("script");
    a.setAttribute("async", "");
    a.setAttribute("defer", "");
    a.setAttribute("src", "https://cdn.utmify.com.br/scripts/pixel/pixel.js");
    document.head.appendChild(a);
  </script>
  
  <HeroVsl videoEmbed={fbVideo} />
  
  <div id="delayed-content" style="display: none;">
    <HeroContent />
    <ForYouSection />
    <PillarsBanner />
    <ConsultantsSection />
  </div>

  <style>
    /* Ocultar inicialmente el footer en esta página y mostrarlo con la clase show-footer */
    :global(.site-footer) {
      display: none !important;
    }
    :global(.show-footer .site-footer) {
      display: block !important;
    }
    /* Dar espacio extra en la parte inferior cuando las secciones secundarias están ocultas */
    :global(body:not(.show-footer) .layout-container) {
      padding-bottom: 6rem;
    }
  </style>

  <script is:inline>
    // Mostrar el contenido después de 8:40 minutos (520000 milisegundos)
    setTimeout(() => {
      const content = document.getElementById('delayed-content');
      if (content) content.style.display = 'block';
      document.body.classList.add('show-footer');
    }, 520000); 
  </script>
</Layout>
