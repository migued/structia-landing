---
import ChevronIcon from './icons/ChevronIcon.astro';

interface Props {
	items: string[];
}
const { items } = Astro.props;
---

<ul class="item-text-list">
	{items.map((text) => (
		<li class="item-text-list__item">
			<ChevronIcon color="#4338CA" size={20} />
			<span class="item-text-list__text" set:html={text} />
		</li>
	))}
</ul>

<style>
	.item-text-list {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}
	.item-text-list__item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.05rem;
		line-height: 1.4;
		max-width: 52ch;
		text-align: left;
	}
	.item-text-list__item :global(.chevron-icon) {
		flex-shrink: 0;
		align-self: center;
	}
	.item-text-list__text {
		flex: 1;
	}
	@media (min-width: 768px) {
		.item-text-list__item {
			font-size: 1.4rem;
			max-width: 46ch;
		}
	}
</style>
