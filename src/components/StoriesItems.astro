---
const BASE_SCRIPT = "https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players";
const videos = [
	{ playerId: "vid-69a5e9d139c8b3b8846d5fbb", scriptUrl: `${BASE_SCRIPT}/69a5e9d139c8b3b8846d5fbb/v4/player.js` },
	{ playerId: "vid-69a5e9dea414172eb5d4b45e", scriptUrl: `${BASE_SCRIPT}/69a5e9dea414172eb5d4b45e/v4/player.js` },
	{ playerId: "vid-69a5e9e3c9fe517b6f73d7b0", scriptUrl: `${BASE_SCRIPT}/69a5e9e3c9fe517b6f73d7b0/v4/player.js` },
	{ playerId: "vid-69a5e9d8d4eb2a015af1b6cd", scriptUrl: `${BASE_SCRIPT}/69a5e9d8d4eb2a015af1b6cd/v4/player.js` },
].map((v) => ({
	...v,
	injectScript: `var s=document.createElement("script");s.src="${v.scriptUrl}";s.async=!0;document.head.appendChild(s);`,
}));
---

<section class="stories-items">
	<div class="stories-carousel">
		<div class="carousel-track">
			{videos.map((video) => (
				<div class="carousel-item">
					<div class="carousel-video-wrapper">
						<vturb-smartplayer
							id={video.playerId}
							style="display: block; margin: 0 auto; width: 100%; max-width: 400px; min-width: 0; min-height: 200px;"
						></vturb-smartplayer>
						<script is:inline type="text/javascript" set:html={video.injectScript} />
					</div>
				</div>
			))}
		</div>
	</div>
	<p class="carousel-hint">Desliza para ver más →</p>
</section>

<style>
	.stories-items {
		width: 100%;
		padding: 2rem 0;
	}

	.stories-carousel {
		max-width: 80ch;
		margin: 0 auto;
		padding: 0 0.5rem;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		cursor: grab;
	}

	.stories-carousel::-webkit-scrollbar {
		display: none;
	}

	.carousel-track {
		display: flex;
		gap: 1rem;
	}

	.carousel-item {
		flex: 0 0 calc(55% - 0.5rem);
		min-width: 0;
	}

	.carousel-video-wrapper {
		width: 100%;
		min-height: 280px;
		aspect-ratio: 9 / 16;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #1a1a2e;
		position: relative;
	}

	.carousel-video-wrapper :global(vturb-smartplayer) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		min-height: 0;
	}

	.carousel-hint {
		text-align: center;
		color: #999;
		font-size: 0.8rem;
		margin: 1rem 0 0;
	}

	@media (min-width: 768px) {
		.stories-carousel {
			padding: 0 1.5rem;
		}

		.carousel-item {
			flex: 0 0 calc(33.333% - 0.667rem);
		}
	}
</style>

<script>
	const carousel = document.querySelector('.stories-carousel') as HTMLElement;
	let isDown = false;
	let startX: number;
	let scrollLeft: number;

	carousel.addEventListener('mousedown', (e) => {
		isDown = true;
		carousel.style.cursor = 'grabbing';
		startX = e.pageX - carousel.offsetLeft;
		scrollLeft = carousel.scrollLeft;
	});

	carousel.addEventListener('mouseleave', () => {
		isDown = false;
		carousel.style.cursor = 'grab';
	});

	carousel.addEventListener('mouseup', () => {
		isDown = false;
		carousel.style.cursor = 'grab';
	});

	carousel.addEventListener('mousemove', (e) => {
		if (!isDown) return;
		e.preventDefault();
		const x = e.pageX - carousel.offsetLeft;
		const walk = (x - startX) * 1.5;
		carousel.scrollLeft = scrollLeft - walk;
	});
</script>
