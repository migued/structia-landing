---
import ShapeIcon from "./icons/ShapeIcon.astro";

/**
 * CONFIGURACIÓN DE ICONOS DE FONDO
 * Puedes mover cada icono cambiando los valores de top, left, right o bottom.
 * Usa valores como: "100px", "-200px", "20%", etc.
 */
const shapes = [
  {
    size: 850,
    color: "#4338CA",
    transparency: 0.7,
    rotation: -30,
    top: "-300px",
    left: "-350px",
  },
  {
    size: 700,
    color: "#4338CA",
    transparency: 0.7,
    rotation: 50,
    top: "15%",
    right: "-150px",
  },
  {
    size: 600,
    color: "#4338CA",
    transparency: 0.8,
    rotation: 120,
    top: "45%",
    left: "-100px",
  },
  {
    size: 500,
    color: "#4338CA",
    transparency: 0.75,
    rotation: -15,
    bottom: "5%",
    right: "-100px",
  },
];
---

<div class="background-container" aria-hidden="true">
  {
    shapes.map((shape) => (
      <div
        class="bg-shape"
        style={{
          top: shape.top,
          left: shape.left,
          right: shape.right,
          bottom: shape.bottom,
        }}
      >
        <ShapeIcon
          size={shape.size}
          color={shape.color}
          transparency={shape.transparency}
          rotation={shape.rotation}
        />
      </div>
    ))
  }
</div>

<style>
  .background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -10;
    overflow: hidden;
  }

  .bg-shape {
    position: absolute;
    width: auto;
    display: block;
    will-change: transform;
  }
</style>
