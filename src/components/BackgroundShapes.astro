---
import structiaIcon from "../assets/structia-icon.png";

/**
 * CONFIGURACIÓN DE ICONOS DE FONDO
 * Puedes mover cada icono cambiando los valores de top, left, right o bottom.
 * Usa valores como: "100px", "-200px", "20%", etc.
 */
const shapes = [
  {
    size: 550,
    transparency: 0.7,
    rotation: 0,
    top: "150px",
    left: "200px",
  },
  {
    size: 450,
    transparency: 0.7,
    rotation: 50,
    top: "15%",
    right: "-100px",
  },
  {
    size: 350,
    transparency: 0.8,
    rotation: 120,
    top: "45%",
    left: "-80px",
  },
  {
    size: 300,
    transparency: 0.75,
    rotation: -15,
    bottom: "10%",
    right: "-50px",
  },
];
---

<div class="background-container" aria-hidden="true">
  {
    shapes.map((shape) => (
      <div
        class="bg-shape"
        style={{
          top: shape.top,
          left: shape.left,
          right: shape.right,
          bottom: shape.bottom,
        }}
      >
        <img
          src={structiaIcon.src}
          alt=""
          style={{
            width: `${shape.size}px`,
            height: "auto",
            opacity: 1 - shape.transparency,
            transform: `rotate(${shape.rotation}deg)`,
          }}
        />
      </div>
    ))
  }
</div>

<style>
  .background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -10;
    overflow: hidden;
  }

  .bg-shape {
    position: absolute;
    width: auto;
    display: block;
    will-change: transform;
  }
</style>
