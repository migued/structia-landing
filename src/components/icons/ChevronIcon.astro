---
interface Props {
	color?: string;
	size?: number;
}
const { color = '#4338CA', size = 20 } = Astro.props;
---

<svg
	class="chevron-icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<path
		d="M10 6 L16 12 L10 18"
		fill="none"
		stroke={color}
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	/>
</svg>
