---
import GradientButton from "./GradientButton.astro";
import StoriesItems from "./StoriesItems.astro";
import logoStructia from "../assets/structia-logo.png";
---

<div class="hero container">
  <div class="hero-content">
    <img src={logoStructia.src} alt="Structia" class="hero-logo" />
    <div class="video-wrapper">
      <vturb-smartplayer
        id="vid-699f264144f8b87400f661f7"
        style="display: block; margin: 0 auto; width: 100%; "
      ></vturb-smartplayer>
      <script is:inline type="text/javascript">
        var s = document.createElement("script");
        ((s.src =
          "https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players/699f264144f8b87400f661f7/v4/player.js"),
          (s.async = !0),
          document.head.appendChild(s));
      </script>
    </div>
    <GradientButton text="Agendar Auditoria" />
    <p class="hero-after-button">
      Las empresas de flipping más <strong
        >exitosas de México pasaron por aquí.</strong
      >
    </p>
    <div class="hero-stories">
      <StoriesItems />
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-logo {
    display: block;
    height: 1.5rem;
    width: auto;
    margin-bottom: 2rem;
  }
  .video-wrapper {
    width: 100%;
    max-width: 720px;
    overflow: hidden;
  }

  .hero :global(.gradient-button) {
    margin-top: 1.25rem;
  }
  .hero-after-button {
    margin-top: 2rem;
    text-align: center;
    font-size: 1.2rem;
    color: #4b5563;
    max-width: 38ch;
  }
  @media (min-width: 768px) {
    .hero-logo {
      margin-bottom: 3rem;
    }
    .hero-after-button {
      font-size: 1.9rem;
    }
  }

  /* Estilos para las historias dentro del Hero */
  .hero-stories {
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-stories {
    }
  }
</style>
