---
import CurvedArrowIcon from "./icons/CurvedArrowIcon.astro";
import ChevronIcon from "./icons/ChevronIcon.astro";

const targetAudience = [
  "<strong>Eres asesor inmobiliario</strong> — Y quieres usar IA para generar guiones de seguimiento, anuncios que te consigan citas y contenido que te posicione como referente sin depender de agencias.",
  "<strong>Eres desarrollador</strong> — Y quieres crear anuncios, campañas y presentaciones con IA que posicionen mejor tus proyectos y aceleren tus ventas.",
  "<strong>Diriges una inmobiliaria</strong> — Y quieres que tu equipo produzca más marketing, mejores copies y mejores anuncios usando IA sin que tú tengas que estar encima de todo.",
  "<strong>Si eres flipper</strong> — Y quieres analizar pre-ofertas más rápido, crear propuestas irresistibles y lanzar campañas que roten tus propiedades sin frenar tu flujo de capital.",
];
---

<section class="banner">
  <div class="banner-content">
    <div class="audience-section">
      <h2 class="include-headline">
        <span class="include-title"
          >¿Para quién es la <span class="include-highlight">membres-IA</span
          >?</span
        >
        <span class="include-subtitle"
          >Es para inmobiliarios que quieren convertir la Inteligencia
          Artificial en producción, más posicionamiento y más ingresos reales.</span
        >
      </h2>
      <ul class="audience-list">
        {
          targetAudience.map((text) => (
            <li class="audience-item">
              <ChevronIcon color="#a9f3e1" size={24} />
              <span class="audience-text" set:html={text} />
            </li>
          ))
        }
      </ul>
    </div>

    <hr class="banner-divider" />

    <h2 class="include-headline">
      <span class="include-title">¿Que incluye Valiant club?</span>
      <span class="include-subtitle"
        >Te enseñamos como usan la IA los inmobiliarios más importantes del
        mundo</span
      >
    </h2>

    <div class="include-description">
      <div class="include-highlight-box">
        <p class="include-text highlight-box-text">
          La forma más rápida de aplicar IA como inmobiliario sin volverte
          experto.
        </p>
      </div>

      <div class="include-features">
        <div class="feature-box">
          <p class="include-text feature-text">
            En Valiant sabemos que la mayoría de los inmobiliarios dejan pasar
            las oportunidades por no decidir a tiempo.
          </p>
        </div>
        <div class="feature-box">
          <p class="include-text feature-text">
            Por eso, durante las proximas 2 horas, nuestra membresia incluyen
            acceso a todo esto:
          </p>
        </div>
      </div>

      <div class="include-arrow">
        <CurvedArrowIcon size="60" />
      </div>
    </div>
  </div>
</section>

<style>
  .banner {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #4743da;
    padding: 2rem 0;
  }

  .banner-content {
    color: #f8f8f8;
    width: 100%;
    /* Replicate centered layout behavior */
    margin: 0 auto;
    padding: 0 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .banner-content {
      max-width: 80ch;
      padding: 0 1.5rem;
    }
  }

  .include-headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
  }

  .include-title {
    font-size: 1.3rem;
    line-height: 1.2;
    font-weight: 700;
    color: white;
  }

  .include-highlight {
    background-color: #a9f3e1;
    color: #1a1a2e;
    border-radius: 0.25em;
    padding: 0.05em 0.25em;
  }

  .include-subtitle {
    font-size: 1.1rem;
    line-height: 1.3;
    max-width: 800px;
    color: #e0e0e0;
  }

  /* Audience Section styles */
  .audience-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    max-width: 100%;
  }

  .audience-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .audience-text {
    font-size: 1rem;
    line-height: 1.4;
    color: #f0f0f0;
    max-width: 60ch;
  }

  .banner-divider {
    width: 100%;
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    margin: 2rem 0;
  }

  .include-description {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 750px; /* Aumentado para acomodar las dos cajas lado a lado */
    margin: 0 auto;
    margin-top: 1.5rem;
  }

  .include-highlight-box {
    background: linear-gradient(90deg, #cdfdf8, #94b9ff);
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    margin-bottom: 0.5rem;
    transform: rotate(-2deg);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .include-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .feature-box {
    background-color: rgba(
      169,
      243,
      225,
      0.1
    ); /* #a9f3e1 0.1 opacity - casi transparente */
    border-radius: 0.5rem;
    padding: 0.5rem;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(169, 243, 225, 0.2); /* Borde sutil para definir los limites */
  }

  .feature-text {
    color: #f0f0f0; /* Texto claro de nuevo para contraste sobre fondo oscuro */
    margin: 0;
    font-weight: 500;
    font-size: 0.95rem; /* Mas pequeño en mobile */
  }

  .highlight-box-text {
    color: black;
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0;
  }

  .highlight-text {
    font-weight: 700;
    color: white;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .include-features {
      flex-direction: row;
      gap: 1.5rem;
    }

    /* Alineacion especifica para desktop */
    .feature-box:first-child .feature-text {
      text-align: right;
    }

    .feature-box:last-child .feature-text {
      text-align: left;
    }

    .include-title {
      font-size: 2.5rem;
    }
    .include-subtitle {
      font-size: 1.7rem;
    }
    .include-text {
      font-size: 1.5rem;
    }
    /* feature-text hereda de include-text, asi que lo sobrescribimos para que sea mas pequeño */
    .feature-text {
      font-size: 1.25rem;
    }
    .highlight-box-text {
      font-size: 2rem;
    }

    /* Audience Section Desktop Styles */
    .audience-text {
      font-size: 1.4rem;
    }
    .audience-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .include-arrow {
    margin-top: 0.5rem;
    display: flex;
    justify-content: center;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }
</style>
