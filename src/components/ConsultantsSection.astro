---
import GradientButton from "./GradientButton.astro";
import whatsappIcon from "../assets/whatsapp.svg";

const consultants = [
  {
    firstName: "Alonso",
    lastName: "Arteaga",
    description:
      '<strong>Inversionista inmobiliario, fundador de Structia, Ubicantón y Valiant.</strong> Ha formado a más de <strong>6,000 empresarios en toda Latinoamérica</strong>. Y realizado mas de <strong>500 operaciones de flipping inmobiliario</strong>.',
  },
  {
    firstName: "Eduardo",
    lastName: "Morales",
    description:
      '<strong>Tecnólogo por nacimiento, programador y cofundador de Valiant.</strong> Estudió y trabajó en Australia, donde desarrolló sistemas de automatización empresarial. Hoy es uno de los <strong>referentes del flipping inmobiliario en Nuevo León</strong>.',
  },
  {
    firstName: "Miguel",
    lastName: "Delgado",
    description:
      '<strong>Especialista en Inteligencia Artificial y programador.</strong> Actualmente radicado en China, se mantiene a la vanguardia de las tecnologías emergentes y es considerado una de las <strong>mentes más avanzadas en IA inmobiliaria</strong>.',
  },
];
---

<section class="consultants container">
  <div class="consultants-content">
    <h2 class="consultants-headline">Tus consultores</h2>

    <div class="consultants-grid">
      {consultants.map((person) => (
        <div class="consultant-card">
          <h3 class="consultant-name">
            <strong>{person.firstName}</strong> {person.lastName}
          </h3>
          <div class="consultant-photo">
            <span class="consultant-photo-placeholder">Foto</span>
          </div>
          <p class="consultant-desc" set:html={person.description} />
        </div>
      ))}
    </div>

    <GradientButton text="QUIERO MI AUDITORÍA" />

    <div class="audit-cta">
      <p class="audit-cta-top">
        Aplica a una llamada de auditoría y descubre si tu empresa está lista para escalar con Structia.
      </p>
      <span class="audit-separator" aria-hidden="true"></span>
      <p class="audit-cta-bottom">
        No todas las empresas califican. Si tu modelo cumple con los requisitos, uno de nuestros consultores te mostrará cómo implementar la estructura que usan las firmas de flipping más rentables del país.
      </p>

      <a href="#" class="support-whatsapp-btn">
        <div class="whatsapp-btn-text">
          <span class="whatsapp-btn-line1">HABLAR CON UN</span>
          <span class="whatsapp-btn-line2">CONSULTOR</span>
          <span class="whatsapp-btn-line3">Dale clic y hablemos</span>
        </div>
        <img src={whatsappIcon.src} alt="WhatsApp" class="whatsapp-btn-icon" />
      </a>
    </div>
  </div>
</section>

<style>
  .consultants {
    width: 100%;
    padding: 2rem 0;
  }

  .consultants-content {
    width: 100%;
    max-width: 80ch;
    margin: 0 auto;
    padding: 0 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .consultants :global(.gradient-button) {
    margin-top: 4rem;
  }

  .consultants-headline {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.2;
    margin-bottom: 2rem;
    color: #1a1a2e;
  }

  .consultants-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  .consultant-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 300px;
    width: 100%;
    gap: 1rem;
  }

  .consultant-name {
    font-size: 1.4rem;
    font-weight: 300;
    color: #1a1a2e;
    margin: 0;
    line-height: 1.2;
  }

  .consultant-name strong {
    font-weight: 800;
  }

  .consultant-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: linear-gradient(180deg, #4642d8, #a29dff);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .consultant-photo-placeholder {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9rem;
  }

  .consultant-desc {
    font-size: 1rem;
    line-height: 1.4;
    color: #374151;
    margin: 0;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .consultants-content {
      padding: 0 1.5rem;
    }

    .consultants-headline {
      font-size: 2.5rem;
    }

    .consultants-grid {
      flex-direction: row;
      justify-content: center;
    }

    .consultant-name {
      font-size: 1.6rem;
    }

    .consultant-desc {
      font-size: 1.05rem;
    }
  }

  /* Audit CTA */
  .audit-cta {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 750px;
  }

  .audit-cta-top {
    font-size: 1.15rem;
    line-height: 1.4;
    color: #1a1a2e;
    font-weight: 600;
    margin: 0;
  }

  .audit-separator {
    display: block;
    width: 80%;
    max-width: 500px;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, #95a0d4, #ffffff);
    margin: 0.25rem auto;
  }

  .audit-cta-bottom {
    font-size: 1rem;
    line-height: 1.4;
    color: #4b5563;
    font-weight: 400;
    margin: 0;
  }

  /* WhatsApp Button */
  .support-whatsapp-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1rem;
    border-radius: 1.25rem;
    border: 3px solid transparent;
    background-image:
      linear-gradient(#fff, #fff), linear-gradient(90deg, #4642d8, #a29dff);
    background-origin: border-box;
    background-clip: padding-box, border-box;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.2s;
    max-width: 480px;
    width: 100%;
  }

  .support-whatsapp-btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
  }

  .whatsapp-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .whatsapp-btn-line1 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1.2;
  }

  .whatsapp-btn-line2 {
    font-size: 2rem;
    font-weight: 800;
    color: #4642d8;
    line-height: 1.1;
  }

  .whatsapp-btn-line3 {
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    margin-top: 0.25rem;
  }

  .whatsapp-btn-icon {
    width: 80px;
    height: auto;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .audit-cta-top {
      font-size: 1.5rem;
    }

    .audit-cta-bottom {
      font-size: 1.2rem;
    }

    .whatsapp-btn-line1 {
      font-size: 1.5rem;
    }

    .whatsapp-btn-line2 {
      font-size: 2.4rem;
    }

    .whatsapp-btn-icon {
      width: 110px;
    }
  }
</style>
