---
import lapItem1 from '../assets/lap-item1.png';
import lapItem2 from '../assets/lap-item2.png';
import ItemText from './ItemText.astro';
import GradientButton from './GradientButton.astro';

const clubItems = [
	'<strong>2 sesiones en vivo cada mes</strong> (IA aplicada al negocio inmobiliario) anuncios, estrategias, guiones, optimización de procesos, análisis de decisiones.',
	'<strong>Acceso a todas las grabaciones</strong> — Construyes tu propia biblioteca estratégica para consultar cuando lo necesites.',
	'<strong>Acceso a la comunidad de inmobilIArios</strong> — Conversaciones de nivel. Ideas aplicadas. Mentalidad de crecimiento.',
	'<strong>Actualizaciones constantes sobre nuevas herramientas</strong> — No te quedas atrás mientras el mercado evoluciona.',
];

const toolsItems = [
	'Evalúa pre-ofertas, rentabilidad y escenarios financieros con <strong>criterios claros para reducir errores y aumentar margen</strong>.',
	'Crea anuncios, propuestas y mensajes persuasivos que <strong>atraen compradores reales</strong>.',
	'Consultores expertos con IA para <strong>dudas estratégicas, legales y operativas</strong>.',
	'Todas las IAs de Pago (ChatGPT, Claude, Gémini, Grok y más) <strong>GRATIS en Valiant</strong>.',
];

const cursoItems = [
	'Guiones persuasivos diseñados para <strong>captar atención en segundos</strong>.',
	'Hooks que activan <strong>curiosidad desde el segundo uno</strong>.',
	'<strong>Creativos con impacto</strong>.',
	'Cómo <strong>estructurar anuncios desde cero</strong> usando IA.',
	'Uso práctico de <strong>Runway, Age y Nano Banana</strong> para creativos.',
];
---

<section class="include-items">
	<div class="include-items-content">
		<div class="item-card">
			<h3 class="item-title">1.VALIANT <span class="title-highlight">CLUB</span></h3>
			<p class="item-subtitle">Comunidad, <strong>clases y acompañamiento</strong></p>
			<div class="item-image-wrapper">
				<img src={lapItem1.src} alt="Valiant Club - Comunidad, clases y acompañamiento" class="item-image" />
			</div>
			<p class="item-description">
				La membresía <strong>donde los inmobiliarios aprenden a usar la IA como ventaja injusta</strong>.
			</p>
			<ItemText items={clubItems} />
		</div>

		<div class="item-card item-card--tools">
			<span class="bono-badge">BONO EXCLUSIVO</span>
			<h3 class="item-title">2. Acceso a Valiant <span class="title-highlight">Tools</span></h3>
			<div class="item-image-wrapper">
				<img src={lapItem2.src} alt="Valiant Tools - Arsenal de herramientas IA" class="item-image" />
			</div>
			<p class="item-description">
				Valiant Tools es tu arsenal privado de <strong>herramientas y agentes de inteligencia artificial</strong> diseñados específicamente para el negocio inmobiliario.
			</p>
			<ItemText items={toolsItems} />
			<div class="tools-highlight-box">
				<p class="tools-highlight-text">
					En lugar de contratar más asistentes, tienes un equipo digital de consultores trabajando 24/7.
				</p>
			</div>
		</div>

		<div class="item-card item-card--tools">
			<span class="bono-badge">BONO DE ACCIÓN RÁPIDA</span>
			<h3 class="item-title">3. CURSO: ANUNCIOS CON IA</h3>
			<p class="item-subtitle">QUE VENDEN <strong>CASAS, TERRENOS Y EDIFICIOS</strong></p>
			<p class="item-description">
				Te enseñamos a diseñar anuncios completos con IA como si tuvieras un <strong>equipo creativo interno</strong> sin contratar otro sueldo.
			</p>
			<ItemText items={cursoItems} />
		</div>

		<p class="items-closing-line">
			Ventas, eficiencia y ventaja…<strong>Esto es lo que consigues por $19/mes</strong>
		</p>
		<GradientButton text="INICIA HOY MISMO" />
	</div>
</section>

<style>
	.include-items {
		width: 100%;
		padding: 2rem 0;
	}

	.include-items-content {
		width: 100%;
		max-width: 80ch;
		margin: 0 auto;
		padding: 0 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.item-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		max-width: 600px;
		width: 100%;
	}

	.item-card--tools {
		margin-top: 3rem;
	}

	.bono-badge {
		background-color: #38b6ff;
		color: #f8f8f8;
		font-size: 0.8rem;
		font-weight: 700;
		padding: 0.3em 0.8em;
		border-radius: 0.35em;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.title-highlight {
		background-color: #5c73f0;
        color: #f8f8f8;
		border-radius: 0.25em;
		padding: 0.05em 0.3em;
	}

	.item-title {
		font-size: 1.4rem;
		font-weight: 700;
		margin: 0;
		line-height: 1.2;
	}

	.item-subtitle {
		font-size: 1.05rem;
		margin: 0;
		line-height: 1.4;
	}

	.item-image-wrapper {
		width: 70%;
		margin: 1rem 0;
		border-radius: 0.75rem;
		overflow: hidden;
	}

	.item-image {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0.75rem;
	}

	.item-description {
		font-size: 1.05rem;
		line-height: 1.3;
		margin: 0;
		max-width: 50ch;
	}

	.tools-highlight-box {
		background: linear-gradient(90deg, #cdfdf8, #94b9ff);
		border-radius: 0.5rem;
		padding: 0.7rem 1rem;
		margin-top: 1.5rem;
		transform: rotate(-2deg);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}

	.tools-highlight-text {
		color: black;
		font-weight: 700;
		font-size: 1.1rem;
		margin: 0;
	}

	.items-closing-line {
		margin: 3rem auto 0.5rem;
		text-align: center;
		font-size: 1.3rem;
		line-height: 1.3;
	}

	.include-items :global(.gradient-button) {
		margin-top: 1.25rem;
	}

	@media (min-width: 768px) {
		.tools-highlight-text {
			font-size: 1.5rem;
		}

		.include-items-content {
			padding: 0 1.5rem;
		}

		.item-number {
			font-size: 1.3rem;
		}

		.item-title {
			font-size: 2.4rem;
		}

		.item-subtitle {
			font-size: 1.6rem;
		}

		.item-description {
			font-size: 1.5rem;
		}

		.item-image-wrapper {
			margin: 1.5rem 0;
		}

		.items-closing-line {
			font-size: 2.25rem;
			max-width: 30ch;
		}
	}
</style>
