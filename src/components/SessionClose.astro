---
// Cierre de la Sesión de Apertura: el "antes / después" de la llamada.
import CtaBlock from "./CtaBlock.astro";
---

<section class="close section">
  <div class="close-panel" data-reveal>
    <div class="close-side close-side--before">
      <span class="close-tag">Entras</span>
      <p class="close-text">
        Entras a la llamada diciendo <span class="close-quote">“algún día”</span
        >...
      </p>
    </div>

    <span class="close-arrow" aria-hidden="true">
      <span class="close-arrow__chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </span>

    <div class="close-side close-side--after">
      <span class="close-tag close-tag--accent">Sales</span>
      <p class="close-text close-text--strong">
        Sales sabiendo <strong>qué operación es la tuya</strong>, por qué
        deberías tomar esa y qué hacer <strong>esta misma semana</strong>.
      </p>
    </div>
  </div>

  <div class="close-cta">
    <CtaBlock />
  </div>
</section>

<style>
  .close-panel {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: var(--card-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .close-side {
    padding: 1.75rem 1.5rem;
    text-align: left;
  }
  .close-side--before {
    background: linear-gradient(
      180deg,
      rgba(18, 19, 42, 0.04),
      rgba(18, 19, 42, 0.012)
    );
  }
  .close-side--after {
    position: relative;
  }
  /* Filo de acento del lado "Sales" */
  .close-side--after::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, var(--brand), var(--brand-3));
  }

  .close-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 0.6rem;
  }
  .close-tag--accent {
    color: var(--brand);
  }
  .close-text {
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink-mute);
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .close-quote {
    font-style: italic;
  }
  .close-text--strong {
    color: var(--ink);
    font-weight: 600;
  }
  .close-text--strong strong {
    font-weight: 800;
  }

  /* Separador con la flecha: en móvil es una fila con la pastilla
     centrada sobre una línea fina; en desktop, la columna del medio. */
  .close-arrow {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.1rem 0;
  }
  .close-arrow::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 1.5rem;
    right: 1.5rem;
    height: 1px;
    background: var(--line-soft);
  }
  .close-arrow__chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--brand);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .close-arrow__chip svg {
    width: 1.1rem;
    height: 1.1rem;
    transform: rotate(90deg);
  }

  .close-cta {
    margin-top: 2.25rem;
  }

  @media (min-width: 820px) {
    .close-panel {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }
    .close-side {
      padding: 2.25rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .close-arrow {
      padding: 0 1rem;
    }
    .close-arrow::before {
      top: 1.75rem;
      bottom: 1.75rem;
      left: 50%;
      right: auto;
      width: 1px;
      height: auto;
    }
    .close-arrow__chip svg {
      transform: none;
    }
    .close-side--after::before {
      display: none;
    }
  }
</style>
