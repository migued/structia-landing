---
// "Esto ya le funcionó a gente tal como tú…"
// Videos de los testimonios que se mencionan en el VSL + el bloque
// "¿Qué tenían en común estas personas?" enlazado con una flecha.

const BASE_SCRIPT =
  "https://scripts.converteai.net/76c39b99-7b9a-4274-9d21-e919f1948fc3/players";

// ⚠️ Verificar que cada playerId corresponda a la persona indicada.
// Player extra disponible: 69a5e9d8d4eb2a015af1b6cd
const testimonials = [
  {
    name: "Juan",
    line: "De vender tacos a tener una empresa reconocida de bienes raíces en Guadalajara.",
    playerId: "vid-69a5e9d139c8b3b8846d5fbb",
    script: `${BASE_SCRIPT}/69a5e9d139c8b3b8846d5fbb/v4/player.js`,
  },
  {
    name: "Tony",
    line: "De mesero a cerrar sus propias operaciones.",
    playerId: "vid-69a5e9dea414172eb5d4b45e",
    script: `${BASE_SCRIPT}/69a5e9dea414172eb5d4b45e/v4/player.js`,
  },
  {
    name: "Eduardo",
    line: "De programador a inversionista en bienes raíces.",
    playerId: "vid-69a5e9e3c9fe517b6f73d7b0",
    script: `${BASE_SCRIPT}/69a5e9e3c9fe517b6f73d7b0/v4/player.js`,
  },
].map((t) => ({
  ...t,
  inject: `var s=document.createElement("script");s.src="${t.script}";s.async=!0;document.head.appendChild(s);`,
}));

const commonPoints = [
  "Ninguno venía de bienes raíces.",
  "Ninguno tenía un mentor.",
  'Ninguno esperó "el momento perfecto".',
  "Y todos habían escuchado que este negocio no era para ellos.",
];
---

<section class="testimonials section">
  <div class="section-head" data-reveal>
    <span class="eyebrow">Historias reales</span>
    <h2 class="section-title">
      Esto ya le funcionó a <em>gente tal como tú…</em>
    </h2>
  </div>

  <div class="tst-carousel">
    <div class="tst-track">
      {
        testimonials.map((t, i) => (
          <article class="tst-card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="tst-video">
              <vturb-smartplayer
                id={t.playerId}
                style="display:block;width:100%;height:100%;"
              />
              <script is:inline type="text/javascript" set:html={t.inject} />
            </div>
            <div class="tst-info">
              <h3 class="tst-name">{t.name}</h3>
              <p class="tst-line">{t.line}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <p class="tst-hint">Desliza para ver más →</p>

  <!-- Flecha que empata con el título de abajo -->
  <div class="tst-arrow" aria-hidden="true" data-reveal>
    <span class="tst-arrow__line"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14"></path>
      <path d="m19 12-7 7-7-7"></path>
    </svg>
  </div>

  <div class="common" data-reveal>
    <h2 class="section-title common-title">
      ¿Qué tenían en común <em>estas personas?</em>
    </h2>

    <ul class="common-list">
      {
        commonPoints.map((p) => (
          <li class="common-item">
            <span class="common-dot" aria-hidden="true" />
            {p}
          </li>
        ))
      }
    </ul>

    <p class="common-kicker">
      Lo único que hicieron distinto fue poner <strong>su combinación</strong>
      sobre la mesa, encontrar <strong>su Próxima Caja</strong> y
      <strong>seguir el mapa</strong>.
    </p>
  </div>
</section>

<style>
  .tst-carousel {
    max-width: 980px;
    margin: 0 auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    padding: 0.25rem;
  }
  .tst-carousel::-webkit-scrollbar {
    display: none;
  }
  .tst-track {
    display: flex;
    gap: 1rem;
  }
  .tst-card {
    flex: 0 0 min(72%, 300px);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    text-align: left;
    display: flex;
    flex-direction: column;
  }
  .tst-video {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #12132a;
    overflow: hidden;
  }
  .tst-video :global(vturb-smartplayer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tst-info {
    padding: 1rem 1.1rem 1.2rem;
  }
  .tst-name {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .tst-line {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .tst-hint {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-mute);
  }

  .tst-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--brand);
    margin: 2rem 0 1.5rem;
  }
  .tst-arrow__line {
    width: 2px;
    height: 3rem;
    background: linear-gradient(180deg, transparent, var(--brand-3));
  }
  .tst-arrow svg {
    width: 1.6rem;
    height: 1.6rem;
    margin-top: -0.4rem;
  }

  .common {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }
  .common-title {
    margin-bottom: 1.75rem;
  }
  .common-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 620px;
    margin: 0 auto;
    text-align: left;
  }
  .common-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .common-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--brand), var(--brand-3));
  }
  .common-kicker {
    max-width: 56ch;
    margin-inline: auto;
    margin-top: 1.75rem;
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
    line-height: 1.5;
    font-weight: 500;
    color: var(--ink);
    text-wrap: pretty;
  }
  .common-kicker strong {
    font-weight: 800;
    color: var(--brand);
  }

  @media (min-width: 860px) {
    .tst-carousel {
      overflow: visible;
      cursor: default;
    }
    .tst-track {
      gap: 1.5rem;
    }
    .tst-card {
      flex: 1 1 0;
    }
    .tst-hint {
      display: none;
    }
  }
</style>

<script>
  // Arrastre con el mouse en el carrusel de testimonios (móvil / tablet).
  const carousel = document.querySelector<HTMLElement>(".tst-carousel");
  if (carousel) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    carousel.addEventListener("mousedown", (e) => {
      isDown = true;
      carousel.style.cursor = "grabbing";
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });
    const stop = () => {
      isDown = false;
      carousel.style.cursor = "";
    };
    carousel.addEventListener("mouseleave", stop);
    carousel.addEventListener("mouseup", stop);
    carousel.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      carousel.scrollLeft = scrollLeft - (x - startX) * 1.5;
    });
  }
</script>
