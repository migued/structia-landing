---
const pillars = [
  {
    badge: "Tecnología",
    title: "Tecnología que no existía, así que la creamos.",
    text: "En el mercado no había una herramienta diseñada para flipperos. Como si tuvieras el equipo de una gran corporación… <strong>sin pagar como una</strong>.",
    accent: "#5c73f0",
  },
  {
    badge: "Estrategia",
    title: "Porque sin dirección, ningún sistema sirve.",
    text: "La mayoría intenta escalar comprando software. Nosotros te enseñamos a <strong>pensar como un estratega</strong>, no como un operador.",
    accent: "#a29dff",
  },
  {
    badge: "Mentalidad",
    title: "La base invisible de cualquier resultado.",
    text: "Muchas veces la falta de dinero no viene de una mala estrategia, sino de una <strong>mentalidad sin estructura</strong>. Toma decisiones como CEO.",
    accent: "#7c5cff",
  },
];
---

<section class="pillars">
  <div class="pillars-inner">
    <!-- Nodo central -->
    <div class="pillars-node">
      <div class="pillars-node__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 2 2 7l10 5 10-5-10-5Z"></path>
          <path d="m2 17 10 5 10-5"></path>
          <path d="m2 12 10 5 10-5"></path>
        </svg>
      </div>
      <span class="pillars-eyebrow">Los pilares del</span>
      <h2 class="pillars-node__title">Universo Structia</h2>
      <span class="pillars-node__divider" aria-hidden="true"></span>
      <div class="pillars-node__items">
        {
          pillars.map((p) => (
            <span class="pillars-node__item">{p.badge}</span>
          ))
        }
      </div>
    </div>

    <!-- Líneas conectoras (solo desktop) -->
    <svg
      class="pillars-connectors"
      viewBox="0 0 1000 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path class="pillars-connector" d="M500 0 C 500 52, 167 28, 167 80"></path>
      <path class="pillars-connector" d="M500 0 L 500 80"></path>
      <path class="pillars-connector" d="M500 0 C 500 52, 833 28, 833 80"></path>
    </svg>

    <!-- Tarjetas -->
    <div class="pillars-grid">
      {
        pillars.map((p) => (
          <article class="pillar-card" style={`--accent: ${p.accent}`}>
            <span class="pillar-badge">{p.badge}</span>
            <h3 class="pillar-title">{p.title}</h3>
            <p class="pillar-text" set:html={p.text} />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    padding: 4rem 1rem 4.5rem;
    color: #1a1a2e;
    overflow: hidden;
  }

  .pillars-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* === Nodo central === */
  .pillars-node {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    border-radius: 1.25rem;
    padding: 2rem 1.75rem 1.75rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(
      180deg,
      rgba(30, 32, 58, 0.92),
      rgba(15, 16, 33, 0.92)
    );
    border: 1px solid rgba(124, 118, 255, 0.28);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.45),
      0 0 45px rgba(70, 66, 216, 0.28);
  }
  .pillars-node__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.85rem;
    display: grid;
    place-items: center;
    color: #fff;
    margin-bottom: 0.35rem;
    background: linear-gradient(180deg, #5c73f0, #4642d8);
    box-shadow: 0 8px 22px rgba(70, 66, 216, 0.55);
  }
  .pillars-node__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .pillars-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #a29dff;
  }
  .pillars-node__title {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .pillars-node__divider {
    width: 80%;
    height: 1px;
    margin: 0.6rem 0 0.3rem;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.18),
      transparent
    );
  }
  .pillars-node__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.4rem;
  }
  .pillars-node__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .pillars-node__item::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: #5c73f0;
    box-shadow: 0 0 8px #5c73f0;
  }

  /* === Conectores === */
  .pillars-connectors {
    display: none;
  }
  .pillars-connector {
    fill: none;
    stroke: rgba(70, 66, 216, 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }

  /* === Tarjetas === */
  .pillars-grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .pillar-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.1rem;
    padding: 1.75rem 1.5rem;
    text-align: left;
    background: linear-gradient(
      180deg,
      rgba(22, 24, 46, 0.95),
      rgba(12, 13, 27, 0.95)
    );
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  /* línea de acento iluminada arriba */
  .pillar-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  /* resplandor suave del acento */
  .pillar-card::after {
    content: "";
    position: absolute;
    top: -45%;
    left: 50%;
    transform: translateX(-50%);
    width: 75%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 30%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow:
      0 22px 50px rgba(0, 0, 0, 0.5),
      0 0 40px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .pillar-badge {
    position: relative;
    display: inline-block;
    margin-bottom: 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pillar-title {
    position: relative;
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
  }
  .pillar-text {
    position: relative;
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.62);
  }
  .pillar-text :global(strong) {
    color: rgba(255, 255, 255, 0.92);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .pillars {
      padding: 5rem 1.5rem 5.5rem;
    }
    .pillars-node {
      padding: 2.25rem 2rem 2rem;
    }
    .pillars-node__title {
      font-size: 2.2rem;
    }
    .pillars-connectors {
      display: block;
      width: 100%;
      height: 70px;
      margin-top: -0.25rem;
    }
    .pillars-grid {
      flex-direction: row;
      align-items: stretch;
      gap: 1.5rem;
      margin-top: 0;
    }
    .pillar-card {
      flex: 1;
      padding: 2rem 1.75rem;
    }
    .pillar-title {
      font-size: 1.35rem;
    }
    .pillar-text {
      font-size: 1.05rem;
    }
  }
</style>
