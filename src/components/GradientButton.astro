---
interface Props {
  text: string;
  href?: string;
  type?: "button" | "submit";
}
const { text, href, type = "button" } = Astro.props;
---

{
  href ? (
    <a href={href} class="gradient-button">
      {text}
    </a>
  ) : (
    <button type={type} class="gradient-button">
      {text}
    </button>
  )
}

<style>
  .gradient-button {
    display: inline-block;
    padding: 1rem 4rem;
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    background: linear-gradient(90deg, #059669 0%, #10b981 50%, #047857 100%);
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    transition:
      box-shadow 0.3s ease,
      transform 0.2s ease;
    font-family: inherit;
    color: white;
  }
  .gradient-button:hover {
    box-shadow:
      0 6px 24px rgba(16, 185, 129, 0.5),
      0 0 30px rgba(5, 150, 105, 0.25);
    transform: translateY(-1px);
  }
  .gradient-button:active {
    transform: translateY(0);
  }
  @media (min-width: 768px) {
    .gradient-button {
      padding: 1rem 8rem;
      font-size: 1.5rem;
    }
  }
</style>
