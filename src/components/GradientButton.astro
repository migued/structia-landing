---
interface Props {
  text: string;
  href?: string;
  type?: "button" | "submit";
}
const { text, href, type = "button" } = Astro.props;
---

{
  href ? (
    <a href={href} class="gradient-button">
      <span class="gradient-button__text">{text}</span>
      <svg
        class="gradient-button__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  ) : (
    <button type={type} class="gradient-button">
      <span class="gradient-button__text">{text}</span>
      <svg
        class="gradient-button__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </button>
  )
}

<style>
  .gradient-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7em;
    padding: 1.1rem 2.5rem;
    font-family: inherit;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    border: none;
    border-radius: 999px;
    background: linear-gradient(90deg, #059669 0%, #10b981 50%, #047857 100%);
    box-shadow:
      0 10px 28px rgba(16, 185, 129, 0.42),
      0 0 0 rgba(16, 185, 129, 0);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .gradient-button__arrow {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .gradient-button:hover {
    transform: translateY(-2px);
    box-shadow:
      0 12px 30px rgba(16, 185, 129, 0.45),
      0 0 28px rgba(5, 150, 105, 0.28);
  }
  .gradient-button:hover .gradient-button__arrow {
    transform: translateX(3px);
  }
  .gradient-button:active {
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .gradient-button {
      padding: 1.4rem 4.25rem;
      font-size: 1.5rem;
    }
  }
</style>
