---
interface Props {
  text: string;
  href?: string;
  type?: "button" | "submit";
}
const { text, href, type = "button" } = Astro.props;
---

{
  href ? (
    <a href={href} class="gradient-button">
      <span class="gradient-button__text">{text}</span>
      <svg
        class="gradient-button__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  ) : (
    <button type={type} class="gradient-button">
      <span class="gradient-button__text">{text}</span>
      <svg
        class="gradient-button__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </button>
  )
}

<style>
  .gradient-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    max-width: 100%;
    padding: 0.95rem 1.6rem;
    font-family: inherit;
    font-size: clamp(0.92rem, 3.6vw, 1.05rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-align: center;
    /* Se permite el salto de línea para que en pantallas angostas
       el botón nunca se salga de los márgenes. */
    text-wrap: balance;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    border: none;
    border-radius: 999px;
    background: linear-gradient(90deg, #059669 0%, #10b981 50%, #047857 100%);
    box-shadow:
      0 8px 22px rgba(16, 185, 129, 0.34),
      0 0 0 rgba(16, 185, 129, 0);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .gradient-button__arrow {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .gradient-button:hover {
    transform: translateY(-2px);
    box-shadow:
      0 10px 26px rgba(16, 185, 129, 0.4),
      0 0 24px rgba(5, 150, 105, 0.24);
  }
  .gradient-button:hover .gradient-button__arrow {
    transform: translateX(3px);
  }
  .gradient-button:active {
    transform: translateY(0);
  }

  /* Pantallas muy angostas: el texto sigue cabiendo en una sola línea. */
  @media (max-width: 380px) {
    .gradient-button {
      padding: 0.9rem 0.9rem;
      letter-spacing: 0;
      gap: 0.5em;
    }
  }

  @media (min-width: 768px) {
    .gradient-button {
      padding: 1.05rem 2.75rem;
      font-size: 1.15rem;
      white-space: nowrap;
    }
  }
</style>
