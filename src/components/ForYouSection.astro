---
// "Una de estas dos columnas es tuya…"
const forYou = [
  "Llevas años juntando para tu primera propiedad… pero cada vez que juntas la inicial, la casa ya subió.",
  "Eres empleado o emprendedor y sabes que tu sueldo solo no te va a dar el patrimonio que quieres.",
  "Estás dispuesto a mirar con honestidad lo que ya tienes: tiempo, contactos, habilidades y capital.",
  "Quieres un mapa con tu nombre — no un método construido alrededor de la realidad de otro.",
];

const notForYou = [
  "Buscas que alguien te dé la respuesta sin estudiar primero tu situación.",
  "Quieres la fórmula de otro sin hacer el trabajo.",
  'Prefieres seguir ahorrando "hasta que alcance" mientras el mercado te sigue ganando.',
  'Vas a seguir esperando "el momento perfecto" mientras tu familia sigue esperando.',
];
---

<section class="fit section">
  <div class="section-head" data-reveal>
    <h2 class="section-title">Una de estas dos columnas <em>es tuya…</em></h2>
  </div>

  <div class="fit-grid">
    <div class="fit-col fit-col--yes" data-reveal>
      <div class="fit-head">
        <span class="fit-icon fit-icon--yes" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <h3 class="fit-title">Esto es para ti…</h3>
      </div>
      <ul class="fit-list">
        {
          forYou.map((t) => (
            <li class="fit-item">
              <span class="fit-bullet fit-bullet--yes" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <p class="fit-text">{t}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="fit-col fit-col--no" data-reveal style="--reveal-delay:110ms">
      <div class="fit-head">
        <span class="fit-icon fit-icon--no" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </span>
        <h3 class="fit-title">Esto no es para ti…</h3>
      </div>
      <ul class="fit-list">
        {
          notForYou.map((t) => (
            <li class="fit-item">
              <span class="fit-bullet fit-bullet--no" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg>
              </span>
              <p class="fit-text">{t}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .fit-col {
    background: var(--card-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem 1.35rem;
    text-align: left;
  }
  .fit-col--yes {
    box-shadow: var(--shadow-md);
    border-color: rgba(70, 66, 216, 0.18);
  }
  .fit-col--no {
    background: linear-gradient(
      180deg,
      rgba(18, 19, 42, 0.045),
      rgba(18, 19, 42, 0.012)
    );
    box-shadow: none;
  }

  .fit-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .fit-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.7rem;
    flex-shrink: 0;
  }
  .fit-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .fit-icon--yes {
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    box-shadow: 0 6px 16px rgba(70, 66, 216, 0.3);
  }
  .fit-icon--no {
    color: var(--ink-mute);
    background: rgba(18, 19, 42, 0.06);
  }
  .fit-title {
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .fit-col--no .fit-title {
    color: var(--ink-mute);
  }

  .fit-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .fit-bullet {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .fit-bullet svg {
    width: 0.75rem;
    height: 0.75rem;
  }
  .fit-bullet--yes {
    color: var(--brand);
    background: var(--brand-soft);
  }
  .fit-bullet--no {
    color: var(--ink-mute);
    background: rgba(18, 19, 42, 0.06);
  }
  .fit-text {
    font-size: 0.96rem;
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .fit-col--yes .fit-text {
    color: var(--ink);
  }

  @media (min-width: 860px) {
    .fit-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .fit-col {
      padding: 2rem 1.85rem;
    }
    .fit-text {
      font-size: 1rem;
    }
  }
</style>
